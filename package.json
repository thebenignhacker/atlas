{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first command center for developers who build many projects with LLM coding tools.",
  "license": "MIT",
  "author": "thebenignhacker",
  "homepage": "https://github.com/thebenignhacker/atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebenignhacker/atlas.git"
  },
  "keywords": [
    "dashboard",
    "developer-tools",
    "local-first",
    "llm",
    "claude-code",
    "productivity",
    "git"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup-db": "tsx scripts/setup-db.ts",
    "scan": "tsx scripts/scan.ts",
    "scan:usage": "tsx scripts/scan-usage.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "snapshot:owner": "tsx scripts/snapshot-owner.ts",
    "context": "tsx bin/atlas-context.ts",
    "test": "node --import tsx --test test/context/*.test.ts test/usage/*.test.ts"
  },
  "bin": {
    "atlas-context": "bin/atlas-context.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
