# Every environment variable Atlas reads. Copy to .env (git-ignored) and fill in
# only what you use. Names only here — never commit a value.

# AI layer (used only when ai.enabled is true in atlas.config.json)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama endpoint for ai.provider "ollama". Default: http://127.0.0.1:11434
OLLAMA_HOST=

# GitHub enrichment. Optional: without it Atlas falls back to the gh CLI, then
# skips enrichment.
GITHUB_TOKEN=

# Deployment mode: local | public | owner | unified. `npm run dev` sets local;
# unset or unrecognised is public, the least privileged mode.
ATLAS_MODE=

# Owner login, required for ATLAS_MODE=owner and ATLAS_MODE=unified.
# AUTH_SECRET: openssl rand -base64 32
# OWNER_PASSWORD_HASH: echo -n 'your-password' | npm run hash-password
AUTH_SECRET=
OWNER_PASSWORD_HASH=

# Where the SQLite index and hook state live. Precedence: ATLAS_DATA_DIR, then
# <ATLAS_HOME>/data, then <repo root>/data.
ATLAS_DATA_DIR=
ATLAS_HOME=

# Rarely set. Repo root when a script runs from another directory (the CLI sets
# it itself); the owner snapshot's path when it is staged outside the tree.
ATLAS_ROOT=
OWNER_SNAPSHOT_PATH=

# CLI and scripts. ATLAS_SESSION_ID attributes new context cards to a session
# (a session-start hook sets it); ATLAS_DEBUG prints stack traces on errors;
# NO_COLOR disables colour in CLI output.
ATLAS_SESSION_ID=
ATLAS_DEBUG=
NO_COLOR=
