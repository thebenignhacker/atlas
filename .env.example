# Every environment variable Atlas reads. Copy to .env (git-ignored) and fill in
# only what you use. Names only here — never commit a value.

# AI layer (only read when ai.enabled is true in atlas.config.json)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub enrichment. Optional: without it Atlas falls back to the gh CLI, then
# skips enrichment.
GITHUB_TOKEN=

# Deployment mode: local (default for npm run dev) | public | owner | unified
ATLAS_MODE=

# Owner login, required for ATLAS_MODE=owner and ATLAS_MODE=unified.
# AUTH_SECRET: openssl rand -base64 32
# OWNER_PASSWORD_HASH: echo -n 'your-password' | npm run hash-password
AUTH_SECRET=
OWNER_PASSWORD_HASH=

# Where the SQLite index and hook state live. Default: ./data in the repo.
ATLAS_DATA_DIR=
