# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets/
credentials/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Atlas -- local data & personal config (NEVER commit: contains your repo paths)
/data
*.db
*.db-shm
*.db-wal
atlas.config.json

# Owner snapshot -- FULL unsanitized data (all repos, paths, private repos, todos,
# digest). NEVER commit. It ships to the login-gated owner deployment via the
# Vercel CLI upload only, never through git.
owner-snapshot.json

# AI assistant files (never commit to a public repo)
CLAUDE.md
AGENTS.md
.claude/
.cursorrules

# local quality-gate markers
.pre-push-review-passed
.release-test-passed

# nightly refresh log (local machinery)
.nightly-refresh.log*

# The template carries names only, no values; it is the documented list of what Atlas reads.
!.env.example
